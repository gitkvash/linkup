# Template for /opt/linkup/.env on the VM. Copy it there, fill it in, chmod 600.
# Never commit the filled-in copy. Named without a leading dot so .gitignore's
# ".env.*" rule doesn't swallow the template.
#
# For every LINKUP_* value, copy what the Render service's Environment tab has today:
# same Supabase database, same JWT secret (or every signed-in user gets logged out).

# --- Read by docker compose itself ---------------------------------------------------
# The hostname Caddy gets a certificate for; its A record must point at the VM's public IP.
DOMAIN=api.example.com

# --- Database (Supabase, session-mode pooler on 5432 - not transaction mode on 6543) ---
LINKUP_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
LINKUP_DB_USERNAME=
LINKUP_DB_PASSWORD=
LINKUP_APP_DB_USERNAME=
LINKUP_APP_DB_PASSWORD=

# --- Redis ---------------------------------------------------------------------------
# Password for the bundled Redis (generate one: openssl rand -hex 32). A fresh Redis
# starts with empty feed timelines. To keep the ones on Render's Redis instead, also set
# LINKUP_REDIS_HOST / LINKUP_REDIS_PORT / LINKUP_REDIS_SSL=true to its values and put
# its password here; the bundled container then just sits unused.
LINKUP_REDIS_PASSWORD=

# --- Auth ----------------------------------------------------------------------------
LINKUP_JWT_SECRET=
LINKUP_GOOGLE_CLIENT_ID=

# --- Push (optional) -----------------------------------------------------------------
# /opt/linkup/secrets on the VM is mounted at /run/secrets/linkup. Leave empty to
# disable FCM.
LINKUP_FCM_CREDENTIALS_PATH=
# LINKUP_FCM_CREDENTIALS_PATH=/run/secrets/linkup/fcm.json
